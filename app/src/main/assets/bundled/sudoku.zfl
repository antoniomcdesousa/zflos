<!doctype html>
<html lang="en">
<head>
<script type="application/zfl-manifest">
{
 "zfl": 1,
 "id": "labs.zfl.sudoku",
 "name": "Sudoku",
 "version": "1.1",
 "icon": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%20512%20512%22%3E%3Crect%20x%3D%2240%22%20y%3D%2240%22%20width%3D%22432%22%20height%3D%22432%22%20rx%3D%2296%22%20fill%3D%22%232b6cb0%22/%3E%3Ctext%20x%3D%22256%22%20y%3D%22340%22%20font-family%3D%22sans-serif%22%20font-size%3D%22260%22%20font-weight%3D%22700%22%20text-anchor%3D%22middle%22%20fill%3D%22%23fff%22%3E9%3C/text%3E%3C/svg%3E",
 "permissions": [
  "camera",
  "storage",
  "overlay",
  "screenshot",
  "share"
 ]
}
</script>

<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sudoku Solver</title>
<style>
  :root{--bg:#fafafa;--fg:#111;--line:#999;--thick:#222;--sel:#cfe3ff;--bad:#ffb3b3;--solved:#1a5fd0;--btn:#2b2b2b}
  @media (prefers-color-scheme:dark){:root{--bg:#161616;--fg:#eee;--line:#555;--thick:#ddd;--sel:#26456e;--bad:#7a2a2a;--solved:#6aa6ff;--btn:#444}}
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  body{margin:0;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif;display:flex;flex-direction:column;align-items:center;padding:12px}
  h1{font-size:18px;margin:4px 0 10px}
  #board{display:grid;grid-template-columns:repeat(9,1fr);width:min(94vw,420px);aspect-ratio:1;border:3px solid var(--thick);user-select:none;touch-action:manipulation}
  .c{display:flex;align-items:center;justify-content:center;font-size:min(6.2vw,26px);font-weight:700;border:1px solid var(--line);cursor:pointer}
  .c:nth-child(3n){border-right:3px solid var(--thick)}
  .c:nth-child(9n){border-right:1px solid var(--line)}
  .c:nth-child(n+19):nth-child(-n+27),.c:nth-child(n+46):nth-child(-n+54){border-bottom:3px solid var(--thick)}
  .c.s{background:var(--sel)}
  .kitem{display:inline-flex;flex-direction:column;align-items:center;gap:4px;margin:4px;padding:6px;border:1px solid var(--line);border-radius:8px}
  .kitem canvas{background:#fff;image-rendering:pixelated}
  #fw{position:fixed;right:10px;bottom:10px;width:156px;background:var(--bg);color:var(--fg);border:2px solid var(--thick);border-radius:10px;box-shadow:0 4px 18px rgba(0,0,0,.45);z-index:1000;display:none;touch-action:none;font-size:12px}
  #fw.big{width:min(92vw,330px)}
  body.floatmode>*:not(#fw):not(#fnote):not(#sendbar):not(script){display:none!important}
  body.floatmode #fw{display:block!important;position:static;width:min(94vw,420px);margin:6px auto 0}
  body.floatmode #fwsize{display:none}
  #fnote{display:none;width:min(94vw,420px);font-size:14px;margin:6px 0}
  body.floatmode #fnote{display:block}
  #fw.pip{position:static;width:100%;box-shadow:none;border:0;border-radius:0}
  #fwh{display:flex;align-items:center;justify-content:space-between;padding:2px 6px;cursor:grab;user-select:none;background:var(--btn);color:#fff;border-radius:8px 8px 0 0}
  #fwh button{background:none;border:0;color:#fff;font-size:15px;padding:2px 6px;cursor:pointer;border-radius:4px}
  #fwg{display:grid;grid-template-columns:repeat(9,1fr);aspect-ratio:1;container-type:inline-size}
  #fwg .w{display:flex;align-items:center;justify-content:center;font-size:6cqw;font-weight:700;border:1px solid var(--line)}
  #fwg .w:nth-child(3n){border-right:2px solid var(--thick)}
  #fwg .w:nth-child(9n){border-right:1px solid var(--line)}
  #fwg .w:nth-child(n+19):nth-child(-n+27),#fwg .w:nth-child(n+46):nth-child(-n+54){border-bottom:2px solid var(--thick)}
  #fwg .w.auto{color:var(--solved);font-weight:500}
  .c.unsure{background:#ffd54a;color:#000}
  .c.bad{background:var(--bad)}
  .c.auto{color:var(--solved);font-weight:500}
  #pad{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;width:min(94vw,420px);margin-top:10px}
  button,label.b{background:var(--btn);color:#fff;border:0;border-radius:8px;padding:12px 0;font-size:18px;text-align:center;cursor:pointer}
  #pad button{font-size:22px}
  #acts{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;width:min(94vw,420px);margin-top:8px}
  #acts .go,#camwrap .go{background:#1a5fd0;font-weight:700}
  #acts button,#acts label.b{font-size:14px;padding:12px 2px}
  #msg{margin:10px 0;min-height:1.4em;width:min(94vw,420px);font-size:14px}
  #scan{display:none;width:min(94vw,420px);margin-top:6px}
  #cv{width:100%;touch-action:none;border:1px solid var(--line)}
  small{opacity:.7}
</style>
</head>
<body>
<h1>Sudoku Solver</h1>
<div id="board"></div>
<div id="msg">Tap a cell, then a number. Or load an image, or use the camera.</div>
<div id="pad"></div>
<div id="acts">
  <button class="go" id="solve">Solve</button>
  <label class="b">Load image<input id="file" type="file" accept="image/*" hidden></label>
  <button id="cam">Camera</button>
  <button id="scr">Screenshot</button>
  <button id="clear">Clear</button>
</div>
<button id="setbtn" style="width:min(94vw,420px);margin-top:8px;background:transparent;color:var(--fg);border:1px solid var(--line);font-size:14px;padding:8px">&#9881; Settings</button>
<div id="settings" style="display:none;width:min(94vw,420px);margin-top:6px;border:1px solid var(--line);border-radius:8px;padding:10px;font-size:14px;line-height:1.4">
  <label><input type="checkbox" id="optFloat"> <b>Floating solution</b><br><small>When solved, show the answer in a small draggable widget that stays on top. On desktop Chrome or Edge it also tries to pop out above your other apps.</small></label>
  <hr style="border:0;border-top:1px solid var(--line);margin:10px 0">
  <label><input type="checkbox" id="optSend"> <b>Auto-send solution</b><br><small>When solved, open your phone's share sheet with the solution as a picture. Pick Messages, Gmail or any app and the people. A browser cannot send silently or pick the recipients for you. The list below is used by the Email and Text buttons, which send the solution as plain text.</small></label>
  <textarea id="sendTo" rows="3" placeholder="One per line: emails and/or phone numbers" style="width:100%;margin-top:8px;font-size:14px;padding:6px"></textarea>
  <small id="sendInfo"></small>
</div>
<div id="sendbar" style="display:none;width:min(94vw,420px);margin-top:8px;grid-template-columns:1fr 1fr;gap:6px">
  <button id="sendShare" style="font-size:15px;padding:10px 2px;grid-column:1/-1">Share picture</button>
  <button id="sendMail" style="font-size:15px;padding:10px 2px">Email the solution</button>
  <button id="sendSms" style="font-size:15px;padding:10px 2px">Text the solution</button>
</div>
<input id="camfile" type="file" accept="image/*" capture="environment" hidden>
<div id="camwrap" style="display:none;width:min(94vw,420px);margin-top:8px">
  <video id="vid" playsinline autoplay muted style="width:100%;background:#000;border-radius:8px"></video>
  <p id="camhint"><small>Point the camera straight down at the puzzle so the whole grid is in view. It reads it by itself.</small></p>
  <button id="camcancel" style="width:100%">Cancel</button>
</div>
<div id="fnote"><b>Solved and verified.</b> Showing only the solution. Press &#x2715; on it to go back to the solver.</div>
<div id="fw">
  <div id="fwh"><span>Solution</span><span><button id="fwsize" title="Bigger / smaller">&#x2922;</button><button id="fwpop" title="Float over other apps" style="display:none">Float &#x29C9;</button><button id="fwx" title="Close">&#x2715;</button></span></div>
  <div id="fwg"></div>
</div>
<div id="scan">
  <p><small>Load an image: it finds the grid, reads the digits and solves. If it cannot find the grid, drag a box around it and press Find digits. Works offline. If it meets a digit style it has not seen, it asks you to confirm just that shape once and remembers it.</small></p>
  <canvas id="cv"></canvas>
  <button id="doscan" style="width:100%;margin-top:6px">Find digits</button>
  <div id="key"></div>
</div>

<script>
const $=s=>document.querySelector(s);
let vals=Array(81).fill(0), auto=Array(81).fill(false), sel=0, bad=new Set(), unsure=new Set();

//SOLVER-START
const boxOf=i=>((i/27|0)*3)+((i%9)/3|0);
function conflicts(g){
  const bad=new Set();
  const units=[];
  for(let r=0;r<9;r++){units.push([...Array(9)].map((_,c)=>r*9+c));}
  for(let c=0;c<9;c++){units.push([...Array(9)].map((_,r)=>r*9+c));}
  for(let b=0;b<9;b++){const u=[];for(let i=0;i<81;i++)if(boxOf(i)===b)u.push(i);units.push(u);}
  for(const u of units){const seen={};for(const i of u){const v=g[i];if(!v)continue;if(seen[v]!==undefined){bad.add(i);bad.add(seen[v]);}seen[v]=i;}}
  return bad;
}
function solveAll(grid,limit){
  let count=0,first=null;
  const g=grid.slice(), rows=Array(9).fill(0), cols=Array(9).fill(0), boxes=Array(9).fill(0);
  for(let i=0;i<81;i++){const v=g[i];if(v){const b=1<<v,r=i/9|0,c=i%9,x=boxOf(i);
    if((rows[r]|cols[c]|boxes[x])&b)return {first:null,count:0};rows[r]|=b;cols[c]|=b;boxes[x]|=b;}}
  const empt=[];for(let i=0;i<81;i++)if(!g[i])empt.push(i);
  const pop=m=>{let n=0;while(m){m&=m-1;n++;}return n;};
  function rec(){
    if(!empt.length){count++;if(!first)first=g.slice();return count>=limit;}
    let best=-1,bm=0,bn=10;
    for(let k=0;k<empt.length;k++){const i=empt[k];
      const m=~(rows[i/9|0]|cols[i%9]|boxes[boxOf(i)])&0x3FE, n=pop(m);
      if(n<bn){best=k;bm=m;bn=n;if(n<=1)break;}}
    if(bn===0)return false;
    const i=empt.splice(best,1)[0], r=i/9|0,c=i%9,x=boxOf(i);
    let m=bm;
    while(m){const b=m&-m;m^=b;
      rows[r]|=b;cols[c]|=b;boxes[x]|=b;g[i]=31-Math.clz32(b);
      if(rec())return true;
      rows[r]^=b;cols[c]^=b;boxes[x]^=b;}
    g[i]=0;empt.splice(best,0,i);return false;
  }
  rec();
  return {first,count};
}
const solve=g=>solveAll(g,1).first;
// Independent check: every row/column/box holds 1-9 exactly once, and all givens are unchanged.
function verify(sol,givens){
  if(!sol||sol.length!==81)return false;
  for(let i=0;i<81;i++){if(givens[i]&&givens[i]!==sol[i])return false;if(!(sol[i]>=1&&sol[i]<=9))return false;}
  for(let k=0;k<9;k++){let r=0,c=0,b=0;
    for(let j=0;j<9;j++){r|=1<<sol[k*9+j];c|=1<<sol[j*9+k];
      b|=1<<sol[((k/3|0)*3+(j/3|0))*9+(k%3)*3+(j%3)];}
    if(r!==0x3FE||c!==0x3FE||b!==0x3FE)return false;}
  return true;
}
//SOLVER-END

// ---------- UI ----------
const board=$('#board');
for(let i=0;i<81;i++){const d=document.createElement('div');d.className='c';d.onclick=()=>{sel=i;render();};board.appendChild(d);}
for(let n=1;n<=9;n++){const b=document.createElement('button');b.textContent=n;b.onclick=()=>setVal(n);$('#pad').appendChild(b);}
const er=document.createElement('button');er.textContent='⌫';er.onclick=()=>setVal(0);$('#pad').appendChild(er);

function render(){
  [...board.children].forEach((d,i)=>{
    d.textContent=vals[i]||'';
    d.className='c'+(i===sel?' s':'')+(unsure.has(i)?' unsure':'')+(bad.has(i)?' bad':'')+(auto[i]?' auto':'');
  });
}
function msg(t){$('#msg').textContent=t;}
function setVal(v){vals[sel]=v;auto[sel]=false;bad=new Set();unsure.delete(sel);if(v&&sel<80)sel++;render();}
document.addEventListener('keydown',e=>{
  if(e.key>='1'&&e.key<='9')setVal(+e.key);
  else if(e.key==='0'||e.key==='Delete'||e.key==='Backspace'){vals[sel]=0;auto[sel]=false;bad=new Set();unsure.delete(sel);render();}
  else if(e.key==='ArrowRight')sel=(sel+1)%81;
  else if(e.key==='ArrowLeft')sel=(sel+80)%81;
  else if(e.key==='ArrowDown')sel=(sel+9)%81;
  else if(e.key==='ArrowUp')sel=(sel+72)%81;
  else if(e.key==='Enter')$('#solve').click();
  else return;
  render();
});
$('#solve').onclick=()=>{
  const givens=vals.map((v,i)=>auto[i]?0:v);
  bad=conflicts(givens);
  if(bad.size){render();msg('Red cells conflict. Fix them (scan misread?) and solve again.');return;}
  const res=solveAll(givens,2);
  if(res.count===0){msg('No solution exists for this grid. A digit is probably wrong or misread. Check the entries.');return;}
  if(res.count>1){msg('This grid has MORE THAN ONE solution, so a valid puzzle is not entered. Digits are probably missing or misread. Nothing was filled in.');return;}
  const s=res.first;
  if(!verify(s,givens)){msg('Internal check failed. Do not use this result.');return;}
  vals=s;auto=givens.map(v=>!v);unsure=new Set();render();
  msg('Solved and verified: unique solution, every row, column and box has 1-9, your digits unchanged. Blue = filled in.');
  afterSolve(s,givens);
};
$('#clear').onclick=()=>{vals.fill(0);auto.fill(false);bad=new Set();unsure=new Set();sel=0;$('#scan').style.display='none';fw.style.display='none';stopCam();render();msg('Cleared.');};


// ---------- Floating solution widget ----------
const fw=$('#fw'),fwg=$('#fwg');
for(let i=0;i<81;i++){const d=document.createElement('div');d.className='w';fwg.appendChild(d);}
function showWidget(){[...fwg.children].forEach((d,i)=>{d.textContent=vals[i]||'';d.className='w'+(auto[i]?' auto':'');});fw.style.display='block';}
let fdrag=null;
$('#fwh').onpointerdown=e=>{if(e.target.tagName==='BUTTON'||fw.classList.contains('pip')||document.body.classList.contains('floatmode'))return;
  const r=fw.getBoundingClientRect();fdrag={dx:e.clientX-r.left,dy:e.clientY-r.top};e.currentTarget.setPointerCapture(e.pointerId);};
$('#fwh').onpointermove=e=>{if(!fdrag)return;
  fw.style.left=Math.max(0,Math.min(innerWidth-fw.offsetWidth,e.clientX-fdrag.dx))+'px';
  fw.style.top=Math.max(0,Math.min(innerHeight-fw.offsetHeight,e.clientY-fdrag.dy))+'px';
  fw.style.right='auto';fw.style.bottom='auto';};
$('#fwh').onpointerup=()=>{fdrag=null;};
$('#fwsize').onclick=()=>fw.classList.toggle('big');
function exitFloat(){   // back to the standard solver screen
  document.body.classList.remove('floatmode');
  fw.style.display='none';
  if(fw.classList.contains('pip')){try{fw.ownerDocument.defaultView.close();}catch(e){}}
  if(typeof vp!=='undefined'&&vp){try{document.exitPictureInPicture().catch(()=>{});}catch(e){}}
}
$('#fwx').onclick=exitFloat;
// Video picture-in-picture: the only way a web page can float over OTHER apps on Android Chrome.
// The solution is drawn on a canvas, streamed into a hidden video, and that video goes into PiP.
const vpOK=!!(document.pictureInPictureEnabled&&HTMLVideoElement.prototype.requestPictureInPicture&&HTMLCanvasElement.prototype.captureStream);
let vp=null;
function paintSolution(c,V,A){   // the solution as a picture: your digits black, filled-in digits blue
  const x=c.getContext('2d'),n=c.width,u=n/9;
  x.fillStyle='#fff';x.fillRect(0,0,n,n);
  x.textAlign='center';x.textBaseline='middle';x.font='bold '+Math.round(u*0.62)+'px system-ui,sans-serif';
  for(let i=0;i<81;i++){const v=V[i];if(!v)continue;x.fillStyle=A[i]?'#1a5fd0':'#111';x.fillText(v,(i%9+0.5)*u,(Math.floor(i/9)+0.5)*u+u*0.04);}
  for(let k=0;k<=9;k++){x.fillStyle='#222';const w=k%3===0?Math.max(3,n/90):Math.max(1,n/300);x.fillRect(k*u-w/2,0,w,n);x.fillRect(0,k*u-w/2,n,w);}
}
function drawVp(){if(vp)paintSolution(vp.cv,vals,auto);}
async function vpStart(){
  const cv=document.createElement('canvas');cv.width=cv.height=450;
  const v=document.createElement('video');v.muted=true;v.playsInline=true;v.setAttribute('playsinline','');
  v.style.cssText='position:fixed;width:2px;height:2px;opacity:0;pointer-events:none;left:0;top:0';document.body.appendChild(v);
  const me={cv,v,t:null};vp=me;drawVp();
  v.srcObject=cv.captureStream(5);
  me.t=setInterval(drawVp,400);
  const end=()=>{clearInterval(me.t);try{v.srcObject.getTracks().forEach(t=>t.stop());}catch(e){}v.remove();if(vp===me)vp=null;};
  v.addEventListener('leavepictureinpicture',()=>{end();exitFloat();});
  try{await v.play();await v.requestPictureInPicture();}catch(e){end();throw e;}
}
if('documentPictureInPicture' in window||vpOK)$('#fwpop').style.display='inline';
$('#fwpop').onclick=async()=>{
  if(vp){try{await document.exitPictureInPicture();}catch(e){}return;}
  if('documentPictureInPicture' in window){   // desktop Chrome/Edge: a live always-on-top window
    try{
      const pw=await documentPictureInPicture.requestWindow({width:280,height:310});
      [...document.styleSheets].forEach(ss=>{try{const st=pw.document.createElement('style');st.textContent=[...ss.cssRules].map(r=>r.cssText).join('\n');pw.document.head.appendChild(st);}catch(e){}});
      pw.document.body.style.cssText='margin:0;background:'+getComputedStyle(document.body).backgroundColor;
      fw.classList.add('pip');pw.document.body.appendChild(fw);
      pw.addEventListener('pagehide',()=>{fw.classList.remove('pip');document.body.appendChild(fw);exitFloat();});
      return;
    }catch(e){}
  }
  if(vpOK){
    try{await vpStart();return;}catch(e){}
  }
  msg('Floating over other apps is not available in this browser. The solution stays on this page.');
};


// ---------- Settings, floating solution, auto-send ----------
const SET_KEY='zfl_sudoku_settings_v1';
let settings={float:true,send:false,to:''}, lastSent='', lastSol=null;
try{Object.assign(settings,JSON.parse(localStorage.getItem(SET_KEY)||'{}'));}catch(e){}
function saveSettings(){try{localStorage.setItem(SET_KEY,JSON.stringify(settings));}catch(e){}}
function parseTo(){
  const emails=[],phones=[];
  for(const raw of settings.to.split(/[\n,;]+/)){
    const t=raw.trim();if(!t)continue;
    if(/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(t))emails.push(t);
    else if(/^\+?[\d\s().-]{7,}$/.test(t))phones.push(t.replace(/[\s().-]/g,''));
  }
  return {emails,phones};
}
function refreshSettingsUI(){
  const {emails,phones}=parseTo();
  $('#sendInfo').textContent=(emails.length||phones.length)?`List: ${emails.length} email${emails.length===1?'':'s'}, ${phones.length} phone number${phones.length===1?'':'s'}.`:'List is empty.';
  const bar=$('#sendbar');
  $('#sendMail').style.display=emails.length?'':'none';$('#sendSms').style.display=phones.length?'':'none';
  $('#sendShare').style.display=settings.send?'':'none';
  bar.style.display=(lastSol&&(settings.send||emails.length||phones.length))?'grid':'none';
  bar.style.gridTemplateColumns=(emails.length&&phones.length)?'1fr 1fr':'1fr';
}
$('#optFloat').checked=settings.float;$('#optSend').checked=settings.send;
$('#sendTo').value=settings.to;
$('#setbtn').onclick=()=>{const e=$('#settings');e.style.display=e.style.display==='none'?'block':'none';};
$('#optFloat').onchange=e=>{settings.float=e.target.checked;saveSettings();
  if(!settings.float)fw.style.display='none';else if(lastSol)showWidget();};
$('#optSend').onchange=e=>{settings.send=e.target.checked;saveSettings();};
$('#sendTo').oninput=e=>{settings.to=e.target.value;saveSettings();refreshSettingsUI();};

function fmtG(g){const o=[];for(let r=0;r<9;r++){if(r&&r%3===0)o.push('');
  let row='';for(let c=0;c<9;c++){if(c&&c%3===0)row+=' ';row+=(g[r*9+c]||'.');}o.push(row);}return o.join('\n');}
function buildText(){return 'Sudoku solution\n\nSolution:\n'+fmtG(lastSol.sol)+'\n\nPuzzle:\n'+fmtG(lastSol.givens)+'\n';}
function mailUrl(emails,text){return 'mailto:'+emails.map(encodeURIComponent).join(',')+'?subject='+encodeURIComponent('Sudoku solution')+'&body='+encodeURIComponent(text);}
function smsUrl(phones,text){return 'sms:'+phones.join(',')+'?&body='+encodeURIComponent(text);}
function openExternal(u){location.href=u;}
$('#sendMail').onclick=()=>{if(lastSol)openExternal(mailUrl(parseTo().emails,buildText()));};
$('#sendSms').onclick=()=>{if(lastSol)openExternal(smsUrl(parseTo().phones,buildText()));};

function solutionBlob(){return new Promise(res=>{const c=document.createElement('canvas');c.width=c.height=720;
  paintSolution(c,lastSol.sol,lastSol.givens.map(g=>!g));c.toBlob(res,'image/png');});}
let shareInfo='';
async function shareImage(){   // opens the phone's share sheet with the solution picture; pick the app and the people
  if(!lastSol)return false;
  const blob=await solutionBlob(),file=new File([blob],'sudoku-solution.png',{type:'image/png'});
  if(window.zfl&&zfl.share&&zfl.share.image){   // ZFLOS host share sheet
    try{const du=await new Promise((res,rej)=>{const fr=new FileReader();fr.onload=()=>res(fr.result);fr.onerror=rej;fr.readAsDataURL(blob);});
      await zfl.share.image(du,'Sudoku solution');shareInfo='Shared.';return true;}
    catch(e){shareInfo=(e&&e.message)||'Could not share.';return false;}
  }
  try{
    if(navigator.canShare&&navigator.canShare({files:[file]})){await navigator.share({files:[file],title:'Sudoku solution'});shareInfo='Shared.';return true;}
  }catch(e){if(e&&e.name==='AbortError'){shareInfo='Share cancelled.';return false;}}
  // no share sheet here: save the picture instead
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='sudoku-solution.png';document.body.appendChild(a);a.click();a.remove();
  shareInfo='This browser has no share sheet, so the picture was saved as sudoku-solution.png. Attach it to your message.';return false;
}
$('#sendShare').onclick=async()=>{const ok=await shareImage();msg(ok?'Shared the solution picture.':shareInfo);};
function autoSend(){
  // Browsers cannot send silently or attach a picture to a prepared message, so: picture to the share sheet if it will open.
  const canShareFiles=!!(navigator.canShare&&navigator.userActivation&&navigator.userActivation.isActive);
  if(canShareFiles){shareImage().then(ok=>msg('Solved and verified. '+(ok?'Solution picture shared.':shareInfo+' Press Share picture to try again.')));}
  else msg('Solved and verified. Press Share picture to send the solution as a picture.');
}
function afterSolve(sol,givens){
  lastSol={sol:sol.slice(),givens:givens.slice()};
  if(settings.float&&window.zfl&&zfl.overlay){   // ZFLOS host: real always-on-top widget, solver steps aside
    fw.style.display='none';document.body.classList.remove('floatmode');
    zfl.overlay.show('',{title:'Solution',grid:sol.slice(),auto:givens.map(g=>!g)})
      .then(()=>zfl.app.toBack())
      .catch(e=>msg('Floating widget: '+((e&&e.message)||e)));
  }else if(settings.float){
    showWidget();document.body.classList.add('floatmode');window.scrollTo(0,0);
    try{ // a real always-on-top window needs a recent tap or click; if there is none, the on-page widget stays
      if((window.documentPictureInPicture||vpOK)&&navigator.userActivation&&navigator.userActivation.isActive&&!fw.classList.contains('pip')&&!vp)$('#fwpop').click();
    }catch(e){}
  }else{fw.style.display='none';document.body.classList.remove('floatmode');}
  refreshSettingsUI();
  if(settings.send){const key=givens.join('');if(key!==lastSent){lastSent=key;autoSend();}}
}
refreshSettingsUI();

// ---------- Image scan ----------
let img=null, rect=null, scale=1;
const cv=$('#cv'), ctx=cv.getContext('2d');
function setImage(url){
  const im=new Image();
  im.onload=()=>{img=im;rectIsAuto=false;const w=Math.min(im.width,840);scale=im.width/w;cv.width=w;cv.height=Math.round(im.height/scale);
    rect={x:0,y:0,w:cv.width,h:cv.height};$('#scan').style.display='block';draw();
    const ag=autoGrid();
    if(ag){rect=ag;draw();msg('Found the grid. Reading the digits...');setTimeout(()=>$('#doscan').click(),0);}
    else msg(NOGRID);};
  im.src=url;
}
const NOGRID='I could not find the whole grid. If the picture was taken at an angle, please retake it from straight above. Otherwise crop it so all of the 9x9 grid is in the picture and load it again. (Or drag a box around the grid and press Find digits.)';
function fileChosen(e){const f=e.target.files[0];if(!f)return;setImage(URL.createObjectURL(f));e.target.value='';}
$('#file').onchange=fileChosen;$('#camfile').onchange=fileChosen;

// Camera works like a QR reader: it keeps looking at the live picture and, when it has read the whole
// puzzle the same way in two frames in a row (and the result is a valid puzzle with one solution), it stops and solves.
let camStream=null, liveOn=false, liveTimer=null, lastSig='', liveStart=0;
function stopCam(){liveOn=false;clearTimeout(liveTimer);if(camStream){camStream.getTracks().forEach(t=>t.stop());camStream=null;}$('#camwrap').style.display='none';}
function readFrame(c){
  img=c;scale=1;rectIsAuto=false;
  const ag=autoGrid();if(!ag)return null;
  rect=ag;
  const st=runScan();if(st.odd>5||!st.cl.length)return null;
  const tpl=loadTpl(),lab=[];
  for(const c2 of st.cl){const m=c2.mean();let bs=0,bd=0;for(const t of tpl){const q=sim(t.v,m);if(q>bs){bs=q;bd=t.d;}}
    if(bs<0.95)return null;lab.push(bd);}
  const found=Array(81).fill(0);
  st.cells.forEach((cell,i)=>{if(cell.kind==='glyph')found[i]=lab[st.assign[i]];else if(cell.kind==='maybe')found[i]=-1;});
  if(found.includes(-1))return null;
  if(conflicts(found).size)return null;
  const r=solveAll(found,2);if(r.count!==1||!verify(r.first,found))return null;
  return found;
}
function liveTry(){
  if(!liveOn)return;
  const v=$('#vid');
  if(v.videoWidth){
    const k=Math.min(1,1280/v.videoWidth),c=document.createElement('canvas');
    c.width=Math.round(v.videoWidth*k);c.height=Math.round(v.videoHeight*k);
    c.getContext('2d').drawImage(v,0,0,c.width,c.height);
    let f=null;try{f=readFrame(c);}catch(e){f=null;}
    const sig=f?f.join(''):'';
    if(sig&&sig===lastSig){
      stopCam();vals=f;auto.fill(false);unsure=new Set();bad=new Set();render();$('#solve').click();return;
    }
    lastSig=sig;
    if(Date.now()-liveStart>12000)$('#camhint').innerHTML='<small>Still looking. Hold the phone steady, straight above the puzzle, with the whole grid filling most of the picture and no glare. If this keeps happening, use Load image instead.</small>';
  }
  liveTimer=setTimeout(liveTry,350);
}

// Screen print: pick a window, tab or screen, grab one picture of it, and read the puzzle from that picture.
$('#scr').onclick=async()=>{
  if(window.zfl&&zfl.screenshot){   // ZFLOS host: pick the app, capture it, read the puzzle
    try{msg('Pick the app that shows the puzzle, then tap Capture.');const u=await zfl.screenshot.pick();msg('Reading the screenshot...');setImage(u);}
    catch(e){msg((e&&e.message)||'Screenshot failed.');}
    return;
  }
  if(!navigator.mediaDevices||!navigator.mediaDevices.getDisplayMedia){
    msg('This browser cannot capture other apps. Take a screenshot with the phone itself (usually Power + Volume Down), then press Load image and pick it.');return;}
  let st=null;
  try{
    st=await navigator.mediaDevices.getDisplayMedia({video:true,audio:false});
    const v=document.createElement('video');v.muted=true;v.playsInline=true;v.srcObject=st;await v.play();
    for(let k=3;k>=1;k--){msg('Capturing in '+k+'... switch to the puzzle now if it is not showing.');await new Promise(r=>setTimeout(r,1000));}
    const c=document.createElement('canvas');c.width=v.videoWidth;c.height=v.videoHeight;c.getContext('2d').drawImage(v,0,0);
    st.getTracks().forEach(t=>t.stop());st=null;
    c.toBlob(b=>setImage(URL.createObjectURL(b)),'image/png');
  }catch(e){
    if(st)st.getTracks().forEach(t=>t.stop());
    msg(e&&e.name==='NotAllowedError'?'Screen capture was cancelled.':'Could not capture the screen here. Take a screenshot with the phone and use Load image.');
  }
};
$('#cam').onclick=async()=>{
  try{
    if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia)throw new Error('no camera api');
    camStream=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'environment'},width:{ideal:1920},height:{ideal:1080}},audio:false});
    $('#vid').srcObject=camStream;$('#camwrap').style.display='block';$('#scan').style.display='none';
    $('#camhint').innerHTML='<small>Point the camera straight down at the puzzle so the whole grid is in view. It reads it by itself.</small>';
    msg('Looking for the puzzle...');lastSig='';liveStart=Date.now();liveOn=true;liveTry();
  }catch(e){$('#camfile').click();}   // no live camera here: use the phone\'s own camera app instead
};
$('#camcancel').onclick=stopCam;

// ---------- Grid finding, digit reading ----------

function draw(){
  ctx.drawImage(img,0,0,cv.width,cv.height);
  if(rect){ctx.strokeStyle='#ff2a2a';ctx.lineWidth=3;ctx.strokeRect(rect.x,rect.y,rect.w,rect.h);}
}
let drag=null;
function pos(e){const r=cv.getBoundingClientRect();return{x:(e.clientX-r.left)*cv.width/r.width,y:(e.clientY-r.top)*cv.height/r.height};}
cv.onpointerdown=e=>{rectIsAuto=false;drag=pos(e);cv.setPointerCapture(e.pointerId);};
cv.onpointermove=e=>{if(!drag)return;const p=pos(e);
  rect={x:Math.min(drag.x,p.x),y:Math.min(drag.y,p.y),w:Math.abs(p.x-drag.x),h:Math.abs(p.y-drag.y)};draw();};
cv.onpointerup=()=>{drag=null;};

// ---------- Scan: group the cells by digit SHAPE, then name each shape once ----------
// A grid only contains 9 different digit shapes, and the same digit looks identical every time it appears.
// So we compare the cells with each other (no guessing from a font), end up with at most ~9 groups,
// and only those groups need a name. Confirmed shapes are remembered on this device for next time.
const GL=24, T_SAME=0.90;
let scanState=null, rectIsAuto=false;

function blur3(v){
  const o=new Float32Array(v.length);
  for(let y=0;y<GL;y++)for(let x=0;x<GL;x++){let s=0,n=0;
    for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){const X=x+dx,Y=y+dy;if(X>=0&&X<GL&&Y>=0&&Y<GL){s+=v[Y*GL+X];n++;}}
    o[y*GL+x]=s/n;}
  return o;
}
function sim(a,b){let d=0,na=0,nb=0;for(let k=0;k<a.length;k++){d+=a[k]*b[k];na+=a[k]*a[k];nb+=b[k]*b[k];}return d/Math.sqrt(na*nb+1e-9);}

function cellGlyph(i,g){
  const r=i/9|0,c=i%9,m=0.16;
  const x=g.sx+c*g.cw+g.cw*m, y=g.sy+r*g.ch+g.ch*m, w=g.cw*(1-2*m), h=g.ch*(1-2*m);
  const tw=Math.max(8,Math.round(w)), th=Math.max(8,Math.round(h));
  g.tmp.width=tw;g.tmp.height=th;g.tc.drawImage(img,x,y,w,h,0,0,tw,th);
  const d=g.tc.getImageData(0,0,tw,th).data, n=tw*th, lum=new Float32Array(n);
  for(let k=0;k<n;k++)lum[k]=0.299*d[4*k]+0.587*d[4*k+1]+0.114*d[4*k+2];
  const bg=[...lum].sort((a,b)=>a-b)[n>>1];
  const ink=new Uint8Array(n);
  for(let k=0;k<n;k++)if(lum[k]<bg-60)ink[k]=1;
  let dropped=0;const stack=[];
  const mark=k=>{if(ink[k]){ink[k]=0;dropped++;stack.push(k);}};
  for(let xx=0;xx<tw;xx++){mark(xx);mark((th-1)*tw+xx);}
  for(let yy=0;yy<th;yy++){mark(yy*tw);mark(yy*tw+tw-1);}
  while(stack.length){const k=stack.pop(),px=k%tw,py=(k/tw)|0;
    if(px>0)mark(k-1);if(px<tw-1)mark(k+1);if(py>0)mark(k-tw);if(py<th-1)mark(k+tw);}
  let cnt=0,minx=1e9,miny=1e9,maxx=-1,maxy=-1;
  for(let k=0;k<n;k++)if(ink[k]){cnt++;const px=k%tw,py=(k/tw)|0;
    if(px<minx)minx=px;if(px>maxx)maxx=px;if(py<miny)miny=py;if(py>maxy)maxy=py;}
  if(cnt<n*0.012)return dropped>n*0.03?{kind:'maybe'}:{kind:'blank'};
  if(cnt<n*0.03||(maxy-miny)<th*0.3)return {kind:'maybe'};
  const bw=maxx-minx+1,bh=maxy-miny+1;
  const q=document.createElement('canvas');q.width=bw;q.height=bh;const qc=q.getContext('2d');
  const id=qc.createImageData(bw,bh);
  for(let yy=0;yy<bh;yy++)for(let xx=0;xx<bw;xx++){const v=ink[(miny+yy)*tw+minx+xx]?0:255,o=4*(yy*bw+xx);
    id.data[o]=id.data[o+1]=id.data[o+2]=v;id.data[o+3]=255;}
  qc.putImageData(id,0,0);
  g.gx.fillStyle='#fff';g.gx.fillRect(0,0,GL,GL);
  const k2=20/Math.max(bw,bh);g.gx.drawImage(q,(GL-bw*k2)/2,(GL-bh*k2)/2,bw*k2,bh*k2);
  const dd=g.gx.getImageData(0,0,GL,GL).data, v=new Float32Array(GL*GL);
  for(let k=0;k<GL*GL;k++)v[k]=1-dd[4*k]/255;
  return {kind:'glyph',v:blur3(v)};
}

function clusterGlyphs(glyphs,T){
  let cl=[];
  const add=(c,g)=>{c.members.push(g);for(let k=0;k<c.sum.length;k++)c.sum[k]+=g.v[k];};
  for(const g of glyphs){
    let best=null,bs=0;
    for(const c of cl){const s=sim(c.mean(),g.v);if(s>bs){bs=s;best=c;}}
    if(best&&bs>=T)add(best,g);
    else{const c={members:[],sum:new Float32Array(GL*GL),mean(){return this.sum.map(x=>x/this.members.length);}};add(c,g);cl.push(c);}
  }
  for(let round=0;round<2;round++){   // re-assign everything to the nearest final group
    const means=cl.map(c=>c.mean());
    const nc=means.map(()=>({members:[],sum:new Float32Array(GL*GL),mean(){return this.sum.map(x=>x/this.members.length);}}));
    for(const g of glyphs){let b=0,bs=-1;means.forEach((m,j)=>{const s=sim(m,g.v);if(s>bs){bs=s;b=j;}});add(nc[b],g);}
    cl=nc.filter(c=>c.members.length);
  }
  return cl;
}

