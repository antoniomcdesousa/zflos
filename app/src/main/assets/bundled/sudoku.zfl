function loadTpl(){return BUILTIN.map(t=>({d:t.d,v:Float32Array.from(t.v)})).concat(loadSaved());}
function saveTpl(list){try{localStorage.setItem(TPL_KEY,JSON.stringify(list.slice(-60).map(t=>({d:t.d,v:Array.from(t.v,x=>Math.round(x*100)/100)}))));}catch(e){}}


// Offline guess for digit shapes it has never seen: draw 1-9 in the fonts this device has and compare.
let FONT_TPL=null;
function fontTemplates(){
  if(FONT_TPL)return FONT_TPL;
  const fonts=['Arial','Helvetica','Roboto','Verdana','Tahoma','Georgia','Times New Roman','Segoe UI','sans-serif','serif','monospace'],out=[];
  const c=document.createElement('canvas');c.width=c.height=120;const x=c.getContext('2d',{willReadFrequently:true});
  const g=document.createElement('canvas');g.width=g.height=GL;const gx=g.getContext('2d',{willReadFrequently:true});
  for(const f of fonts)for(const w of ['400','700'])for(let n=1;n<=9;n++){
    x.fillStyle='#fff';x.fillRect(0,0,120,120);x.fillStyle='#000';x.textAlign='center';
    x.font=`${w} 90px ${f.includes(' ')?'"'+f+'"':f}`;x.fillText(String(n),60,95);
    const d=x.getImageData(0,0,120,120).data;let minx=999,miny=999,maxx=-1,maxy=-1;
    for(let k=0;k<14400;k++)if(d[4*k]<128){const px=k%120,py=(k/120)|0;if(px<minx)minx=px;if(px>maxx)maxx=px;if(py<miny)miny=py;if(py>maxy)maxy=py;}
    if(maxx<0)continue;
    const bw=maxx-minx+1,bh=maxy-miny+1;gx.fillStyle='#fff';gx.fillRect(0,0,GL,GL);
    const k2=20/Math.max(bw,bh);gx.drawImage(c,minx,miny,bw,bh,(GL-bw*k2)/2,(GL-bh*k2)/2,bw*k2,bh*k2);
    const dd=gx.getImageData(0,0,GL,GL).data,v=new Float32Array(GL*GL);
    for(let k=0;k<GL*GL;k++)v[k]=1-dd[4*k]/255;
    out.push({d:n,v:blur3(v)});
  }
  return FONT_TPL=out;
}
function fontGuess(mean){
  const best={};for(const t of fontTemplates()){const s=sim(t.v,mean);if(!(best[t.d]>=s))best[t.d]=s;}
  const r=Object.entries(best).sort((a,b)=>b[1]-a[1]);
  return r.length>1&&r[0][1]>=0.80&&r[0][1]-r[1][1]>=0.04?r[0][0]:'';
}

function thumb(v,px){
  const c=document.createElement('canvas');c.width=c.height=GL;const x=c.getContext('2d'),id=x.createImageData(GL,GL);
  for(let k=0;k<GL*GL;k++){const s=255*(1-Math.min(1,v[k]*1.2));id.data[4*k]=id.data[4*k+1]=id.data[4*k+2]=s;id.data[4*k+3]=255;}
  x.putImageData(id,0,0);c.style.width=c.style.height=px+'px';return c;
}

function showKey(){
  const K=$('#key');K.innerHTML='';const {cl}=scanState, tpl=loadTpl();
  cl.forEach((c,ci)=>{
    const mean=c.mean(),box=document.createElement('div');box.className='kitem';
    box.appendChild(thumb(mean,56));
    const cnt=document.createElement('div');cnt.textContent='×'+c.members.length;box.appendChild(cnt);
    const sel=document.createElement('select');sel.id='k'+ci;sel.style.fontSize='20px';
    sel.innerHTML='<option value="">?</option>'+[1,2,3,4,5,6,7,8,9].map(n=>`<option>${n}</option>`).join('');
    let bs=0,bd=0;for(const t of tpl){const s=sim(t.v,mean);if(s>bs){bs=s;bd=t.d;}}
    if(bs>=0.95){sel.value=String(bd);c.src='saved';}
    else{const gd=fontGuess(mean);if(gd){sel.value=gd;sel.style.background='#ffe9a8';}}
    box.appendChild(sel);K.appendChild(box);
  });
  const b=document.createElement('button');b.textContent='Use these digits';b.style.cssText='width:100%;margin-top:8px';b.onclick=applyKey;K.appendChild(b);
  const allSaved=cl.every(c=>c.src==='saved');
  const odd=scanState.cells.filter(c=>c.kind==='maybe').length;
  msg(`Found ${cl.length} digit shape${cl.length===1?'':'s'}${cl.length>9?' (more than 9: some digits are drawn in more than one style, label each)':''}. `+
      (odd>5?`WARNING: ${odd} cells look odd, so I have probably not found the grid correctly. If the picture was taken at an angle, please retake it from straight above. Otherwise crop it closer to the grid and load it again, or drag a box around the grid. `:'')+(allSaved?'All digits recognised.':'Some shapes are new to me. Yellow = my best guess: check it against the picture. Pick any ? boxes, then press "Use these digits".'));
  if(allSaved&&odd<=5){applyKey();if(!unsure.size&&!bad.size)$('#solve').click();}
}

function applyKey(){
  const {cells,cl,assign,ambig}=scanState,lab=[];
  if(scanState.odd>5){msg(`I have probably not found the grid correctly (${scanState.odd} cells look odd). If the picture was taken at an angle, please retake it from straight above. Otherwise crop it so the whole 9x9 grid fills it and load it again, or drag a box around the grid and press Find digits.`);return;}
  for(let ci=0;ci<cl.length;ci++){const v=+$('#k'+ci).value;if(!v){msg('Name every shape first (the ? boxes).');return;}lab.push(v);}
  const found=Array(81).fill(0),us=new Set();
  cells.forEach((c,i)=>{if(c.kind==='glyph'){found[i]=lab[assign[i]];if(ambig[i])us.add(i);}else if(c.kind==='maybe')us.add(i);});
  const tpl=loadSaved();cl.forEach((c,ci)=>{if(c.src!=='saved')tpl.push({d:lab[ci],v:c.mean()});});saveTpl(tpl);
  vals=found;auto.fill(false);unsure=us;bad=conflicts(vals);render();
  draw();ctx.strokeStyle='#ff2a2a';ctx.lineWidth=1;
  for(let k=1;k<9;k++){ctx.beginPath();ctx.moveTo(rect.x+rect.w*k/9,rect.y);ctx.lineTo(rect.x+rect.w*k/9,rect.y+rect.h);
    ctx.moveTo(rect.x,rect.y+rect.h*k/9);ctx.lineTo(rect.x+rect.w,rect.y+rect.h*k/9);ctx.stroke();}
  msg(`${found.filter(Boolean).length} digits placed. ${us.size?us.size+' yellow cell(s) look unusual: check them. ':''}Compare the grid with your photo, then press Solve.`);
}

// Step 1: find the 9x9 grid by itself. Its outline is the biggest, roughly square, connected set of sharp edges.
function autoGrid(){
  // Try several edge strengths / sizes so the result does not depend on how big the picture or the grid is.
  for(const [thr,dil,md] of [[70,1,900],[70,0,1400],[40,0,1400],[40,1,1400],[25,0,1800]]){const r=autoGridTry(thr,dil,md);if(r)return r;}
  return null;
}
function autoGridTry(thr,dil,md){
  const W0=img.naturalWidth||img.width,H0=img.naturalHeight||img.height;
  const f=Math.min(1,md/Math.max(W0,H0)),w=Math.max(20,Math.round(W0*f)),h=Math.max(20,Math.round(H0*f));
  const c=document.createElement('canvas');c.width=w;c.height=h;const x=c.getContext('2d',{willReadFrequently:true});
  x.drawImage(img,0,0,w,h);const d=x.getImageData(0,0,w,h).data,n=w*h,L=new Float32Array(n);
  for(let k=0;k<n;k++)L[k]=0.299*d[4*k]+0.587*d[4*k+1]+0.114*d[4*k+2];
  const E=new Uint8Array(n);
  for(let y=0;y<h;y++)for(let xx=0;xx<w;xx++){
    const gx=L[y*w+Math.min(w-1,xx+1)]-L[y*w+Math.max(0,xx-1)],gy=L[Math.min(h-1,y+1)*w+xx]-L[Math.max(0,y-1)*w+xx];
    if(Math.abs(gx)+Math.abs(gy)>thr)E[y*w+xx]=1;}
  const D=new Uint8Array(n);
  for(let y=0;y<h;y++)for(let xx=0;xx<w;xx++)if(E[y*w+xx])
    for(let dy=-dil;dy<=dil;dy++)for(let dx=-dil;dx<=dil;dx++){const X=xx+dx,Y=y+dy;if(X>=0&&X<w&&Y>=0&&Y<h)D[Y*w+X]=1;}
  const seen=new Uint8Array(n),stack=new Int32Array(n),cands=[],subs=[];let best=null;
  for(let st=0;st<n;st++){
    if(!D[st]||seen[st])continue;
    let sp=0,minx=w,miny=h,maxx=0,maxy=0;stack[sp++]=st;seen[st]=1;
    while(sp){const k=stack[--sp],px=k%w,py=(k/w)|0;
      if(px<minx)minx=px;if(px>maxx)maxx=px;if(py<miny)miny=py;if(py>maxy)maxy=py;
      if(px>0&&D[k-1]&&!seen[k-1]){seen[k-1]=1;stack[sp++]=k-1;}
      if(px<w-1&&D[k+1]&&!seen[k+1]){seen[k+1]=1;stack[sp++]=k+1;}
      if(py>0&&D[k-w]&&!seen[k-w]){seen[k-w]=1;stack[sp++]=k-w;}
      if(py<h-1&&D[k+w]&&!seen[k+w]){seen[k+w]=1;stack[sp++]=k+w;}}
    const bw=maxx-minx+1,bh=maxy-miny+1,asp=bw/bh;
    if(bw>=w*0.2&&asp>0.85&&asp<1.18)cands.push({area:bw*bh,minx,miny,maxx,maxy});
    else if(bw>=w*0.2&&bw>=40)subs.push({minx,miny,maxx,maxy,bw,bh});   // grid joined to other screen parts (pad, buttons, card edge): search inside
  }
  // A real Sudoku grid has 8 evenly spaced inner lines each way. Pick the candidate that shows that pattern.
  const lineScore=c=>{
    const bw=c.maxx-c.minx+1,bh=c.maxy-c.miny+1,cw=bw/9,ch=bh/9,cl=v=>Math.max(0,Math.min(w-1,Math.round(v))),rl=v=>Math.max(0,Math.min(h-1,Math.round(v)));
    let tot=0,cnt=0;
    for(let k=1;k<9;k++){
      let X=cl(c.minx+k*cw),hit=0,n2=0;
      for(let y=rl(c.miny+bh*0.05);y<=rl(c.maxy-bh*0.05);y+=2){
        const ref=Math.max(L[y*w+cl(X-cw*0.4)],L[y*w+cl(X+cw*0.4)]),m=Math.min(L[y*w+cl(X-1)],L[y*w+X],L[y*w+cl(X+1)]);
        n2++;if(m<ref-25)hit++;}
      tot+=hit/Math.max(1,n2);cnt++;
      let Y=rl(c.miny+k*ch);hit=0;n2=0;
      for(let xx=cl(c.minx+bw*0.05);xx<=cl(c.maxx-bw*0.05);xx+=2){
        const ref=Math.max(L[rl(Y-ch*0.4)*w+xx],L[rl(Y+ch*0.4)*w+xx]),m=Math.min(L[rl(Y-1)*w+xx],L[Y*w+xx],L[rl(Y+1)*w+xx]);
        n2++;if(m<ref-25)hit++;}
      tot+=hit/Math.max(1,n2);cnt++;
    }
    return tot/cnt;
  };
  // For a window cut out of a merged blob: the grid must have a border line on each outer edge and NO further grid lines just outside it.
  const hfrac=(c,Y0)=>{let bestf=0;for(let dy=-2;dy<=2;dy++){const Y=Math.max(1,Math.min(h-2,Y0+dy));const bw=c.maxx-c.minx+1;let hit=0,n2=0;
      for(let xx=c.minx+Math.round(bw*0.05);xx<=c.maxx-Math.round(bw*0.05);xx+=2){const ref=Math.max(L[Math.max(0,Y-Math.round(bw/9*0.4))*w+xx],L[Math.min(h-1,Y+Math.round(bw/9*0.4))*w+xx]);
        const m=Math.min(L[(Y-1)*w+xx],L[Y*w+xx],L[(Y+1)*w+xx]);n2++;if(m<ref-25)hit++;}
      bestf=Math.max(bestf,hit/Math.max(1,n2));}return bestf;};
  const vfrac=(c,X0)=>{let bestf=0;for(let dx=-2;dx<=2;dx++){const X=Math.max(1,Math.min(w-2,X0+dx));const bh=c.maxy-c.miny+1;let hit=0,n2=0;
      for(let y=c.miny+Math.round(bh*0.05);y<=c.maxy-Math.round(bh*0.05);y+=2){const ref=Math.max(L[y*w+Math.max(0,X-Math.round(bh/9*0.4))],L[y*w+Math.min(w-1,X+Math.round(bh/9*0.4))]);
        const m=Math.min(L[y*w+X-1],L[y*w+X],L[y*w+X+1]);n2++;if(m<ref-25)hit++;}
      bestf=Math.max(bestf,hit/Math.max(1,n2));}return bestf;};
  const subScore=c=>{
    const side=c.maxx-c.minx+1,cs=Math.round(side/9),inner=lineScore(c);if(inner<=0)return 0;
    const t=hfrac(c,c.miny+1),bt=hfrac(c,c.maxy-1),l=vfrac(c,c.minx+1),r=vfrac(c,c.maxx-1);
    const oy=(c.miny-cs>2?hfrac(c,c.miny-cs):0),oy2=(c.maxy+cs<h-3?hfrac(c,c.maxy+cs):0);
    const ox=(c.minx-cs>2?vfrac(c,c.minx-cs):0),ox2=(c.maxx+cs<w-3?vfrac(c,c.maxx+cs):0);
    const edge=Math.min(1,t*1.5)*Math.min(1,bt*1.5)*Math.min(1,l*1.5)*Math.min(1,r*1.5);
    return inner*edge*(1-0.7*Math.max(oy,oy2,ox,ox2));
  };
  // ---- Corner-first search: find the top-left corner (a horizontal line and a vertical line that start at the same point),
  // measure along both lines to guess the size, and keep the box that really looks like a 9x9 grid. Works wherever the grid sits.
  {
    const R=10,I=new Float64Array((w+1)*(h+1));
    for(let y=0;y<h;y++){let rs=0;for(let xx=0;xx<w;xx++){rs+=L[y*w+xx];I[(y+1)*(w+1)+xx+1]=I[y*(w+1)+xx+1]+rs;}}
    const D=new Uint8Array(n);
    for(let y=0;y<h;y++)for(let xx=0;xx<w;xx++){
      const x0=Math.max(0,xx-R),x1=Math.min(w,xx+R+1),y0=Math.max(0,y-R),y1=Math.min(h,y+R+1);
      const m=(I[y1*(w+1)+x1]-I[y0*(w+1)+x1]-I[y1*(w+1)+x0]+I[y0*(w+1)+x0])/((x1-x0)*(y1-y0));
      if(L[y*w+xx]<m-22)D[y*w+xx]=1;}
    const minLen=Math.max(40,Math.round(0.2*Math.min(w,h))),GAP=3,Hs=[],Vs=[];
    for(let y=0;y<h;y++){let xx=0;while(xx<w){if(!D[y*w+xx]){xx++;continue;}let e=xx,gap=0,k=xx;while(k<w&&gap<=GAP){if(D[y*w+k]){e=k;gap=0;}else gap++;k++;}if(e-xx+1>=minLen)Hs.push({y,x0:xx,x1:e});xx=e+1;}}
    for(let xx=0;xx<w;xx++){let y=0;while(y<h){if(!D[y*w+xx]){y++;continue;}let e=y,gap=0,k=y;while(k<h&&gap<=GAP){if(D[k*w+xx]){e=k;gap=0;}else gap++;k++;}if(e-y+1>=minLen)Vs.push({x:xx,y0:y,y1:e});y=e+1;}}
    const seenC=new Set(),boxes=[];
    for(const hr of Hs)for(const vr of Vs){
      if(Math.abs(vr.x-hr.x0)>5||Math.abs(vr.y0-hr.y)>5)continue;
      const cx=Math.min(vr.x,hr.x0),cy=Math.min(vr.y0,hr.y),key=((cx/6)|0)+','+((cy/6)|0);
      if(seenC.has(key))continue;seenC.add(key);
      const Ss=new Set([Math.min(hr.x1-hr.x0,vr.y1-vr.y0)]);
      for(const v2 of Vs)if(Math.abs(v2.y0-vr.y0)<=5&&v2.x-vr.x>=minLen)Ss.add(v2.x-vr.x);
      for(const h2 of Hs)if(Math.abs(h2.x0-hr.x0)<=5&&h2.y-hr.y>=minLen)Ss.add(h2.y-hr.y);
      for(const S of Ss){if(cx+S>=w||cy+S>=h)continue;boxes.push({minx:cx,miny:cy,maxx:cx+S,maxy:cy+S});}
      if(boxes.length>400)break;
    }
    let cb=null,cs=0.30;
    for(const b of boxes){const sc=subScore(b);if(sc>cs){cs=sc;cb=b;}}
    if(cb){   // polish: nudge the corner and size by a few pixels
      let bb=cb,bs=cs;
      for(let dx=-3;dx<=3;dx++)for(let dy=-3;dy<=3;dy++)for(let dS=-3;dS<=3;dS++){
        const c={minx:cb.minx+dx,miny:cb.miny+dy,maxx:cb.maxx+dx+dS,maxy:cb.maxy+dy+dS};
        if(c.minx<1||c.miny<1||c.maxx>=w-1||c.maxy>=h-1)continue;
        const sc=subScore(c);if(sc>bs){bs=sc;bb=c;}}
      rectIsAuto=true;const ins=1.5;
      return {x:(bb.minx+ins)/f/scale,y:(bb.miny+ins)/f/scale,w:(bb.maxx-bb.minx+1-2*ins)/f/scale,h:(bb.maxy-bb.miny+1-2*ins)/f/scale};
    }
  }
  cands.sort((a,b)=>b.area-a.area);
  let ps=0.45;
  for(const c of cands.slice(0,8)){const sc=lineScore(c);if(sc>ps){ps=sc;best=c;}}
  // Merged blobs: slide a square window of the blob's width (or height) along it and keep the one showing the grid-line pattern.
  for(const b of subs.sort((a,c)=>c.bw*c.bh-a.bw*a.bh).slice(0,4)){
    const side=Math.min(b.bw,b.bh),step=Math.max(2,Math.round(side*0.02));
    if(b.bh>b.bw*1.18){for(let y0=b.miny;y0+side<=b.maxy+1;y0+=step){const c={minx:b.minx,maxx:b.maxx,miny:y0,maxy:y0+side-1};const sc=subScore(c);if(sc>ps){ps=sc;best=c;}}}
    else if(b.bw>b.bh*1.18){for(let x0=b.minx;x0+side<=b.maxx+1;x0+=step){const c={minx:x0,maxx:x0+side-1,miny:b.miny,maxy:b.maxy};const sc=subScore(c);if(sc>ps){ps=sc;best=c;}}}
  }
  if(!best)return null;
  const ins=1.5;rectIsAuto=true;
  return {x:(best.minx+ins)/f/scale,y:(best.miny+ins)/f/scale,w:(best.maxx-best.minx+1-2*ins)/f/scale,h:(best.maxy-best.miny+1-2*ins)/f/scale};
}

// Snap the box onto the grid's own thick border lines, so a slightly sloppy box still lines up.
function snapGrid(frac){
  const W=img.naturalWidth||img.width,H=img.naturalHeight||img.height;
  const c=document.createElement('canvas');c.width=W;c.height=H;
  const x=c.getContext('2d',{willReadFrequently:true});x.drawImage(img,0,0);
  const d=x.getImageData(0,0,W,H).data;
  const L=(px,py)=>{const o=4*(py*W+px);return 0.299*d[o]+0.587*d[o+1]+0.114*d[o+2];};
  let X0=rect.x*scale,Y0=rect.y*scale,X1=(rect.x+rect.w)*scale,Y1=(rect.y+rect.h)*scale;
  const cell=Math.min(X1-X0,Y1-Y0)/9,S=Math.round(cell*(frac||0.22));
  const samp=[];
  for(let a=0;a<20;a++)for(let b=0;b<20;b++)samp.push(L(Math.min(W-1,Math.max(0,Math.round(X0+(X1-X0)*(a+.5)/20))),Math.min(H-1,Math.max(0,Math.round(Y0+(Y1-Y0)*(b+.5)/20)))));
  const bg=samp.sort((a,b)=>a-b)[samp.length>>1];
  function bestLine(pos,vertical,a0,a1){
    const lo=Math.round(pos-S),scores=[],lim=vertical?W:H,span=vertical?H:W;
    for(let p=lo;p<=Math.round(pos+S);p++){
      if(p<2||p>lim-3){scores.push(0);continue;}
      let s=0;for(let t=Math.max(0,Math.round(a0));t<Math.min(span,Math.round(a1));t+=2)s+=Math.max(0,bg-(vertical?L(p,t):L(t,p)));
      scores.push(s);}
    const sm=scores.map((_,i)=>{let s=0,n=0;for(let j=-3;j<=3;j++)if(scores[i+j]!==undefined){s+=scores[i+j];n++;}return s/n;});
    let bi=0;sm.forEach((v,i)=>{if(v>sm[bi])bi=i;});
    const med=[...sm].sort((a,b)=>a-b)[sm.length>>1];
    return sm[bi]>1.3*med+1?lo+bi:pos;
  }
  X0=bestLine(X0,true,Y0,Y1);X1=bestLine(X1,true,Y0,Y1);
  Y0=bestLine(Y0,false,X0,X1);Y1=bestLine(Y1,false,X0,X1);
  rect={x:X0/scale,y:Y0/scale,w:(X1-X0)/scale,h:(Y1-Y0)/scale};
}

function runScan(){
  snapGrid(rectIsAuto?0.10:0.22);
  const g={sx:rect.x*scale,sy:rect.y*scale,cw:rect.w*scale/9,ch:rect.h*scale/9,
    tmp:document.createElement('canvas'),gc:document.createElement('canvas')};
  g.tc=g.tmp.getContext('2d',{willReadFrequently:true});
  g.gc.width=g.gc.height=GL;g.gx=g.gc.getContext('2d',{willReadFrequently:true});
  const cells=[];for(let i=0;i<81;i++)cells.push(cellGlyph(i,g));
  const glyphs=[];cells.forEach((c,i)=>{if(c.kind==='glyph')glyphs.push({i,v:c.v});});
  const cl=clusterGlyphs(glyphs,T_SAME), assign={}, ambig={}, means=cl.map(c=>c.mean());
  cl.forEach((c,ci)=>c.members.forEach(m=>{assign[m.i]=ci;}));
  for(const gl of glyphs){const ss=means.map(m=>sim(m,gl.v)).sort((a,b)=>b-a);
    ambig[gl.i]=ss[0]<T_SAME+0.03||(ss.length>1&&ss[0]-ss[1]<0.04);}
  scanState={cells,cl,assign,ambig,odd:cells.filter(c=>c.kind==='maybe').length};return scanState;
}
$('#doscan').onclick=()=>{
  if(!img||!rect||rect.w<30||rect.h<30){msg('Drag a box around the grid first.');return;}
  runScan();showKey();
};

render();
</script>
</body>
</html>
