<!doctype html><html><head>
<script type="application/zfl-manifest">
{
 "zfl": 1,
 "id": "labs.zfl.notepad",
 "name": "Notepad",
 "version": "1.0",
 "icon": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%20512%20512%22%3E%3Crect%20x%3D%2240%22%20y%3D%2240%22%20width%3D%22432%22%20height%3D%22432%22%20rx%3D%2296%22%20fill%3D%22%232f855a%22/%3E%3Ctext%20x%3D%22256%22%20y%3D%22340%22%20font-family%3D%22sans-serif%22%20font-size%3D%22260%22%20font-weight%3D%22700%22%20text-anchor%3D%22middle%22%20fill%3D%22%23fff%22%3EN%3C/text%3E%3C/svg%3E",
 "permissions": [
  "storage",
  "notify",
  "overlay",
  "clipboard",
  "vibrate"
 ]
}
</script>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Notepad</title>
<style>body{font:16px system-ui;margin:0;padding:14px;background:#fff;color:#111}textarea{width:100%;height:40vh;font:inherit;padding:8px}button{font:inherit;padding:10px 12px;margin:6px 6px 0 0}#s{color:#555;margin-top:8px}</style></head>
<body><h3 style="margin:0 0 8px">Notepad</h3><textarea id="t" placeholder="Type a note. It is saved through the ZFLOS bridge."></textarea>
<div><button id="pin">Float it</button><button id="unpin">Unfloat</button><button id="copy">Copy</button><button id="ping">Notify</button></div><div id="s"></div>
<script>
const t=document.getElementById('t'),s=document.getElementById('s');
const say=x=>s.textContent=x;
zfl.storage.get('note').then(v=>{if(v)t.value=v;say('Loaded saved note')}).catch(e=>say(e.message));
t.oninput=()=>zfl.storage.set('note',t.value);
pin.onclick=()=>zfl.overlay.show(t.value||'(empty)').then(()=>say('Floating'));
unpin.onclick=()=>zfl.overlay.hide();
copy.onclick=()=>zfl.clipboard.write(t.value).then(()=>say('Copied')).catch(e=>say(e.message));
ping.onclick=()=>{zfl.notify('Note saved',t.value.slice(0,40));zfl.vibrate(80)};
</script></body></html>
